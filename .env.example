# Copie para .env (ou defina no painel do Render) e preencha. NUNCA versione o .env real.
# ------------------------------------------------------------------ núcleo
PORT=3000
DATA_DIR=/var/data                 # disco persistente (Render). Local: cai em ./data
# ------------------------------------------------------------------ Stays.net
STAYS_CLIENT_ID=xxxxxxxx
STAYS_SECRET=xxxxxxxx
# STAYS_BASE_URL=https://...        # opcional
# ------------------------------------------------------------------ Portal Staff
JWT_SECRET=troque-por-um-segredo-longo
ADMIN_EMAIL=augusto.villela@gmail.com
ADMIN_INITIAL_PASSWORD=troque-no-primeiro-acesso
PUBLISH_KEY=chave-de-publicacao-dos-agentes
# ------------------------------------------------------------------ E-mail (SMTP Gmail)
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASS=senha-de-app-do-gmail
# ------------------------------------------------------------------ WhatsApp (via Make/n8n)
MAKE_WA_WEBHOOK=https://hook.make.com/xxxx   # POST {to, text}
# ------------------------------------------------------------------ Mercado Pago (compartilhado com app do hóspede)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx             # produção; sandbox p/ testes

# ================================================================== LIVRARIA VILLELA
# Loja pública server-rendered + Portal Staff (Gestão de Livros).
LIVRARIA_URL=https://livros.villelastay.com.br   # domínio público da loja (canonical/OG/webhook/back_urls)
LIVRARIA_WHATSAPP=556191935013                   # número do CTA de WhatsApp da loja
LIVRARIA_TOKEN_HORAS=72                           # validade do link de download
LIVRARIA_TOKEN_MAX=5                              # máximo de downloads por link
LIVRARIA_EVENTS_WEBHOOK=                          # webhook interno p/ Make/n8n (eventos: venda_aprovada, pdf_entregue, ...)
# --- pixels de conversão (opcionais; carregam só se preenchidos) ---
META_PIXEL_ID=                                    # Meta/Facebook Pixel
GOOGLE_ADS_ID=                                    # Google Ads / GA4 (ex.: AW-XXXX ou G-XXXX)
# Nota: o webhook do Mercado Pago para a livraria é  {LIVRARIA_URL}/livraria/webhooks/mercadopago
#       (isolado do webhook /webhooks/mercadopago do app do hóspede).
