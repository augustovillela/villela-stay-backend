# Vitrine — variáveis de ambiente (exemplo; NENHUM valor secreto aqui).
# Nenhuma é obrigatória para rodar o MVP simulado.

# Seed de demonstração fora de development (on/off) e senha das contas demo
#VITRINE_SEED=off
#VITRINE_DEMO_SENHA=

# Rotina horária (expirar não pagos, avançar rastreio simulado, concluir vencidos)
#VITRINE_ROTINAS=on

# Provedor de pagamento: simulado (padrão) | mercadopago-split (fase 6)
#VITRINE_PAGAMENTO_PROVEDOR=simulado
#VITRINE_MP_APP_ID=
#VITRINE_MP_SECRET=

# Segredo do webhook de pagamento (sem ele, um é gerado e guardado na config)
#VITRINE_WEBHOOK_SECRET=

# Provedor de frete: simulado (padrão) | melhor-envio (fase 6)
#VITRINE_FRETE_PROVEDOR=simulado
#VITRINE_MELHOR_ENVIO_TOKEN=
