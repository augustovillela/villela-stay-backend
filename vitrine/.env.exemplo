# Vitrine — variáveis de ambiente (exemplo; NENHUM valor secreto aqui).
# Nenhuma é obrigatória para rodar o MVP simulado.

# Seed de demonstração fora de development (on/off) e senha das contas demo
#VITRINE_SEED=off
#VITRINE_DEMO_SENHA=

# Rotina horária (expirar não pagos, avançar rastreio simulado, concluir vencidos)
#VITRINE_ROTINAS=on

# ---- Mercado Pago Split Payments (fase 6) ----
# Credenciais da APLICAÇÃO marketplace (dashboard do Mercado Pago →
# Suas integrações). Use as credenciais de TESTE para sandbox; com elas
# preenchidas, vendedor conectado via OAuth passa a receber direto na conta
# dele com a comissão da plataforma (marketplace_fee) descontada.
#VITRINE_MP_APP_ID=
#VITRINE_MP_SECRET=
# Segredo de assinatura do webhook (dashboard MP → Webhooks → assinatura secreta)
#VITRINE_MP_WEBHOOK_SECRET=

# Segredo do webhook genérico/simulado (sem ele, um é gerado e guardado na config)
#VITRINE_WEBHOOK_SECRET=

# ---- Melhor Envio (fase 6) ----
# Token da conta (sandbox.melhorenvio.com.br → Integrações → Tokens).
# VITRINE_MELHOR_ENVIO_SANDBOX=on (padrão) usa o ambiente de testes.
#VITRINE_FRETE_PROVEDOR=melhor-envio
#VITRINE_MELHOR_ENVIO_TOKEN=
#VITRINE_MELHOR_ENVIO_SANDBOX=on
