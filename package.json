{
  "name": "villela-stay-backend",
  "version": "0.1.0",
  "description": "Backend da Villela Stay: proxy seguro da API Stays.net, webhooks e base do CRM",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:legal": "node legal/selftest.js",
    "test:legal-saas": "node legal-saas/selftest.js",
    "test:vdocs": "node vdocs/selftest.js",
    "test:vpe": "node vpe/selftest.js",
    "test:vsm": "node vsm/selftest.js",
    "test:academy": "node academy/selftest.js",
    "test:crm": "node crm/selftest.js",
    "test:closet": "node closet/selftest.js",
    "test:alta-vista": "node alta-vista/selftest.js",
    "test:growth": "node growth/selftest.js",
    "test:vitrine": "node vitrine/selftest.js",
    "test:kids": "node kids/selftest.js",
    "test:origena": "node --env-file-if-exists=.env origena/selftest.js",
    "origena:worker": "node --env-file-if-exists=.env origena/worker.js",
    "verificar:finance": "node financeiro/verificar-producao.js",
    "verificar:closet": "node closet/verificar-producao.js",
    "verificar:vitrine": "node vitrine/verificar-producao.js",
    "verificar:kids": "node kids/verificar-producao.js",
    "test:finance": "node financeiro/selftest.js",
    "test:nucleo": "node selftest-nucleo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.0",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  }
}
