{
  "name": "villela-stay-backend",
  "version": "0.1.0",
  "description": "Backend da Villela Stay: proxy seguro da API Stays.net, webhooks e base do CRM",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:legal": "node legal/selftest.js",
    "test:legal-saas": "node legal-saas/selftest.js",
    "test:vdocs": "node vdocs/selftest.js",
    "test:vpe": "node vpe/selftest.js",
    "test:vsm": "node vsm/selftest.js",
    "test:academy": "node academy/selftest.js",
    "test:crm": "node crm/selftest.js",
    "test:closet": "node closet/selftest.js",
    "test:alta-vista": "node alta-vista/selftest.js",
    "test:growth": "node growth/selftest.js",
    "test:vitrine": "node vitrine/selftest.js",
    "test:kids": "node kids/selftest.js",
    "test:origena": "node --env-file-if-exists=.env origena/selftest.js",
    "origena:worker": "node --env-file-if-exists=.env origena/worker.js",
    "finance:market-worker": "node --env-file-if-exists=.env financeiro/mercado-worker.js",
    "finance:market-e2e": "node --env-file-if-exists=.env financeiro/mercado-e2e.js",
    "finance:market-pilot-cvm": "node --env-file-if-exists=.env financeiro/mercado-piloto-cvm.js",
    "finance:market-quality-cvm": "node --env-file-if-exists=.env financeiro/mercado-qualidade-cvm.js",
    "finance:market-conflicts-cvm": "node --env-file-if-exists=.env financeiro/mercado-conflitos-cvm.js",
    "finance:market-duplicates-cvm": "node --env-file-if-exists=.env financeiro/mercado-duplicidades-cvm.js",
    "finance:market-canonical-cvm": "node --env-file-if-exists=.env financeiro/mercado-canonico-cvm.js",
    "seguranca:finance": "node financeiro/seguranca.js",
    "verificar:finance": "node financeiro/verificar-producao.js",
    "verificar:closet": "node closet/verificar-producao.js",
    "verificar:vitrine": "node vitrine/verificar-producao.js",
    "verificar:kids": "node kids/verificar-producao.js",
    "test:finance": "node financeiro/selftest.js",
    "test:music": "node music/selftest.js",
    "test:livraria": "node livraria/selftest.js",
    "test:voz": "node voz/selftest.js",
    "test:comunicados": "node comunicados/selftest.js",
    "test:mcp": "node mcp-staff/selftest.js",
    "music:worker": "node music/worker.js",
    "test:nucleo": "node selftest-nucleo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "csv-parse": "^7.0.3",
    "express": "^4.19.0",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  }
}
