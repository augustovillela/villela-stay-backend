# Villela Kids — variáveis de ambiente (nenhuma é obrigatória para subir)

# Semeia a família de demonstração (só roda com o banco vazio; nunca sobrescreve)
# KIDS_SEED=on
# KIDS_DEMO_SENHA=defina-uma-senha-forte

# Tutor IA (onda 2) — usa a ANTHROPIC_API_KEY global do servidor e LIGA SOZINHO
# quando ela existe (o tutor é o produto). Sem chave, "modo simples" (fallbacks
# curados do roteiro) — a missão nunca trava.
# KIDS_IA_MOTOR=off            # kill-switch do LLM
# KIDS_IA_MODELO=claude-sonnet-5
# KIDS_IA_TIMEOUT_MS=30000
